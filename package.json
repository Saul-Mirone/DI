{
  "name": "@enorim/di",
  "description": "A light weight dependency injection library.",
  "type": "module",
  "version": "0.0.3",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "tsc",
    "test": "vitest --run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saul-Mirone/di.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.15.0",
    "oxlint": "^1.29.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "packageManager": "pnpm@11.5.2"
}
